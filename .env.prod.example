# Copiar a /opt/hicotea/deploy/.env.prod (chmod 600). Nunca versionar secretos.
# Generar cada secreto por separado: openssl rand -hex 32
# Usar hex para la contraseña: evita caracteres reservados en la URL SQLAlchemy.
POSTGRES_PASSWORD=
HICOTEA_CODIGO_INVITACION=
HICOTEA_API_IMAGE=ghcr.io/roa26/hicotea-api:sha-REEMPLAZAR
HICOTEA_WEB_IMAGE=ghcr.io/roa26/hicotea-web:sha-REEMPLAZAR
