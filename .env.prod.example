# Copiar a /opt/hicotea/deploy/.env.prod (chmod 600). Nunca versionar secretos.
# Generar cada secreto por separado: openssl rand -hex 32
# Usar hex para la contraseña: evita caracteres reservados en la URL SQLAlchemy.
POSTGRES_PASSWORD=
# Opcional (modo heredado). Mientras tenga valor, ese código sigue sirviendo para
# registrarse además de las invitaciones del panel. Déjalo vacío cuando ya exista
# un administrador: el registro queda solo con invitaciones individuales.
HICOTEA_CODIGO_INVITACION=
# Correo para el PIN de recuperación: ninguno | smtp. Sin SMTP el PIN queda en el log.
HICOTEA_CORREO_MODO=ninguno
HICOTEA_CORREO_REMITENTE=Hicotea <no-responder@hicotea.duckdns.org>
HICOTEA_SMTP_HOST=
HICOTEA_SMTP_PUERTO=587
HICOTEA_SMTP_USUARIO=
HICOTEA_SMTP_CONTRASENA=
HICOTEA_SMTP_SEGURIDAD=starttls
HICOTEA_API_IMAGE=ghcr.io/roa26/hicotea-api:sha-REEMPLAZAR
HICOTEA_WEB_IMAGE=ghcr.io/roa26/hicotea-web:sha-REEMPLAZAR
