# Copiar a api/.env
HICOTEA_DATABASE_URL=postgresql+psycopg://hicotea:hicotea@localhost:5432/hicotea
# Base para los tests (se crea y se borra sola). Debe ser del mismo servidor.
HICOTEA_TEST_DATABASE_URL=postgresql+psycopg://hicotea:hicotea@localhost:5432/hicotea_test
# Código global de invitación (modo heredado, opcional). Si tiene valor, sirve para
# registrarse además de las invitaciones individuales del panel /admin.
# Para crear la primera cuenta sin código: uv run python -m app.cli invitacion crear
HICOTEA_CODIGO_INVITACION=cambia-esto
HICOTEA_COOKIE_SECURE=false
HICOTEA_ORIGENES_PERMITIDOS=["http://localhost:5173"]
# URL de la web, para armar los enlaces de invitación.
HICOTEA_URL_PUBLICA=http://localhost:5173
# Correo del PIN de recuperación: ninguno (PIN en el log) | consola (correo en el log) | smtp
HICOTEA_CORREO_MODO=consola
