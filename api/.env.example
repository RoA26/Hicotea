# Copiar a api/.env
HICOTEA_DATABASE_URL=postgresql+psycopg://hicotea:hicotea@localhost:5432/hicotea
# Base para los tests (se crea y se borra sola). Debe ser del mismo servidor.
HICOTEA_TEST_DATABASE_URL=postgresql+psycopg://hicotea:hicotea@localhost:5432/hicotea_test
# Código que se pide al registrarse (cámbialo).
HICOTEA_CODIGO_INVITACION=cambia-esto
HICOTEA_COOKIE_SECURE=false
HICOTEA_ORIGENES_PERMITIDOS=["http://localhost:5173"]
